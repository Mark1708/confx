{
  "name": "confx",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Browser extension for exporting Confluence and Jira content to Markdown, CSV, and ZIP archives",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:yandex": "TARGET=yandex vite",
    "build": "npm run build:chrome",
    "build:chrome": "tsc -b && vite build --outDir dist",
    "build:yandex": "tsc -b && TARGET=yandex vite build --outDir dist-yandex",
    "gen:key:yandex": "mkdir -p keys && [ -f keys/yandex.pem ] || openssl genrsa -out keys/yandex.pem 2048",
    "zip:chrome": "node scripts/zip-chrome.mjs",
    "pack:yandex": "node scripts/pack-yandex.mjs",
    "checksums": "node scripts/checksums.mjs",
    "release:chrome": "npm run build:chrome && npm run zip:chrome",
    "release:yandex": "npm run build:yandex && npm run pack:yandex",
    "release:all": "npm run release:chrome && npm run release:yandex && npm run checksums",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.453.0",
    "marked": "^18.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "crx3": "^2.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.9",
    "vitest": "^4.1.7"
  }
}
